# syntax=docker/dockerfile:1.7
# Keep loader outputs resident between Manager jobs while preserving the verified runtime.
FROM ghcr.io/akagik/runpod-comfyui-qwen-image-21-bf16:0.1.2@sha256:06ccef7c0797b550a3fbb1809adc7648a39c6188890bcd22d41c208231558c7a
LABEL org.opencontainers.image.version="0.1.3"
COPY --chmod=755 scripts/start.sh /opt/qwen-image-21-bf16/scripts/start.sh
RUN bash -n /opt/qwen-image-21-bf16/scripts/start.sh \
    && grep -q -- '--cache-classic' /opt/qwen-image-21-bf16/scripts/start.sh \
    && ! grep -q -- '--cache-none' /opt/qwen-image-21-bf16/scripts/start.sh
